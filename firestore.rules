rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function own(uid) { return signedIn() && request.auth.uid == uid; }
    function teacher() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }
    function validProfileCreate(uid) {
      return own(uid)
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'student'
        && request.resource.data.xp == 0
        && request.resource.data.streak == 0;
    }
    function validProfileUpdate(uid) {
      return own(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.xp is int
        && request.resource.data.xp >= resource.data.xp
        && request.resource.data.xp <= resource.data.xp + 100;
    }
    match /users/{uid} {
      allow get: if own(uid) || teacher();
      allow list: if teacher();
      allow create: if validProfileCreate(uid);
      allow update: if validProfileUpdate(uid);
      allow delete: if false;
      match /progress/{lessonId} {
        allow read: if own(uid) || teacher();
        allow create, update: if own(uid)
          && request.resource.data.lessonId == lessonId
          && request.resource.data.progress is number
          && request.resource.data.progress >= 0
          && request.resource.data.progress <= 100
          && request.resource.data.score is number
          && request.resource.data.score >= 0
          && request.resource.data.score <= 100;
        allow delete: if false;
      }
      match /researchJournal/{entryId} {
        allow read: if own(uid) || teacher();
        allow create, update: if own(uid) && request.resource.data.projectId == entryId;
        allow delete: if own(uid);
      }
      match /achievements/{achievementId} {
        allow read: if own(uid) || teacher();
        allow create: if own(uid) && request.resource.data.achievementId == achievementId;
        allow update, delete: if false;
      }
      match /experiments/{experimentId} {
        allow read: if own(uid) || teacher();
        allow create: if own(uid) && request.resource.data.experimentId == experimentId;
        allow update, delete: if false;
      }
    }
    match /lessons/{lessonId} {
      allow read: if resource.data.published == true || teacher();
      allow write: if teacher();
      match /questions/{questionId} {
        allow read: if get(/databases/$(database)/documents/lessons/$(lessonId)).data.published == true || teacher();
        allow write: if teacher();
      }
    }
    match /elements/{elementId} {
      allow read: if true;
      allow write: if teacher();
    }
    match /experiments/{experimentId} {
      allow read: if resource.data.published == true || teacher();
      allow write: if teacher();
    }
    match /projects/{projectId} {
      allow read: if resource.data.published == true || teacher();
      allow write: if teacher();
    }
    match /catalogState/{stateId} {
      allow read: if true;
      allow write: if teacher();
    }
  }
}
